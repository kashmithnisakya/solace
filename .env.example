# Copy this file to .env and fill in your values. Never commit .env.
OPENAI_API_KEY=sk-...

# Optional: override the models (empty = Agents SDK default)
SOLACE_MODEL=
SOLACE_SAFETY_MODEL=

# Country whose crisis lines are shown first
SOLACE_REGION=LK

# Conversation storage (use :memory: to keep nothing on disk)
SOLACE_DB_PATH=data/solace.db
